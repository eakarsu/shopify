# Application and database (required)
DATABASE_URL=postgresql://USER@HOST:5432/DATABASE?connection_limit=5
NEXTAUTH_URL=https://shop.example.com
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes

# Stripe payment intent creation and signed inbound events (required for checkout)
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key

# Tax provider HTTP contract (required for checkout quotes)
TAX_PROVIDER_BASE_URL=https://tax-provider.example.com
TAX_PROVIDER_API_KEY=replace-with-tax-provider-api-key

# Shipping quote, shipment purchase, and signed delivery contract (required)
SHIPPING_PROVIDER_BASE_URL=https://shipping-provider.example.com
SHIPPING_PROVIDER_API_KEY=replace-with-shipping-provider-api-key
SHIPPING_WEBHOOK_SECRET=replace-with-shipping-webhook-hmac-secret
